RAILS_ENV=development
RACK_ENV=development
SUPPLY_MODE=fixture
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:8b
# Empty sends nothing, which is the default: qwen3 needs its thinking tokens to fill the Travel DNA — with
# "none" a parse comes back in 4s instead of 31s and drops half the dimensions. Set it for a model that
# reasons well without them, or to trade DNA completeness for latency.
LLM_REASONING_EFFORT=
LLM_API_KEY=
# Seconds, for both connect and read. A local qwen3:8b takes ~31s to parse a Dream, so the 1s default this
# shipped with meant a fresh clone timed out on every call, tripped the circuit, and looked like a model
# that was never configured.
LLM_TIMEOUT_SECONDS=120
LLM_CIRCUIT_BREAKER_SECONDS=30
LLM_INPUT_USD_PER_MILLION_TOKENS=0
LLM_OUTPUT_USD_PER_MILLION_TOKENS=0
DATABASE_URL=postgres://localhost/elsewhere_development
TEST_DATABASE_URL=postgres://localhost/elsewhere_test
REDIS_URL=redis://localhost:6379/0
OHSOME_BASE_URL=https://api.ohsome.org/v1
ORS_BASE_URL=https://api.openrouteservice.org
ORS_API_KEY=
IGNAV_BASE_URL=https://ignav.com/api
IGNAV_API_KEY=
